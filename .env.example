# Copy this file to .env and fill in your own values. .env is ignored by git.

# Foundry resource endpoint, from the Foundry portal (Overview or the deployment's page)
# Looks like: https://<your-resource-name>.services.ai.azure.com  or  https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.services.ai.azure.com

# API key for that resource (Keys and Endpoint)
AZURE_OPENAI_API_KEY=<your-key>

# The DEPLOYMENT name you chose when deploying the model, e.g. gpt-4.1-mini
AZURE_OPENAI_MODEL=gpt-4.1-mini
